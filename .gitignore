# Datasets (too large: 164 MB, and sign_mnist_train.csv alone is 80 MB).
# Note this is data/ at the repo root, not python/data/. The MNIST raw
# idx-ubyte files under data/MNIST/ are NOT .csv, so the directory rule --
# not the extension rule -- is what actually excludes them.
data/
*.csv
